{
  "name": "demo",
  "services": {
    "api": {
      "build": { "context": "/home/user/demo", "dockerfile": "Dockerfile" },
      "command": null,
      "environment": { "DB_PASSWORD": "SUPERSECRET-DO-NOT-LEAK" },
      "ports": [
        { "mode": "ingress", "target": 8000, "published": "8000", "protocol": "tcp" }
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/home/user/demo/data",
          "target": "/app/data",
          "bind": { "create_host_path": true }
        }
      ]
    },
    "db": {
      "environment": { "POSTGRES_PASSWORD": "SUPERSECRET-DO-NOT-LEAK" },
      "image": "postgres:15-alpine",
      "ports": [
        { "mode": "ingress", "target": 5432, "published": "5432", "protocol": "tcp" }
      ],
      "restart": "unless-stopped",
      "privileged": true,
      "volumes": [
        { "type": "volume", "source": "db_data", "target": "/var/lib/postgresql/data", "volume": {} }
      ]
    }
  },
  "volumes": { "db_data": { "name": "demo_db_data" } }
}
