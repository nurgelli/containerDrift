{
  "name": "containerdrift",
  "networks": {
    "default": {
      "name": "containerdrift_default",
      "ipam": {}
    }
  },
  "services": {
    "web": {
      "command": null,
      "entrypoint": null,
      "image": "nginx:alpine",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "8080",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 90,
          "published": "9090",
          "protocol": "udp"
        }
      ],
      "privileged": true,
      "restart": "unless-stopped"
    }
  }
}
