{
  "name": "containerdrift",
  "networks": {
    "default": {
      "name": "containerdrift_default",
      "ipam": {}
    }
  },
  "services": {
    "web": {
      "command": null,
      "entrypoint": null,
      "image": "nginx:alpine",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 3000,
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 8000,
          "published": "8000",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 8001,
          "published": "8001",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 8002,
          "published": "8002",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "host_ip": "::1",
          "target": 70,
          "published": "7070",
          "protocol": "tcp"
        }
      ],
      "restart": "on-failure:3",
      "volumes": [
        {
          "type": "bind",
          "source": "C:\\Users\\demo\\project\\data",
          "target": "/data",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        },
        {
          "type": "volume",
          "source": "cache",
          "target": "/cache",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "cache": {
      "name": "containerdrift_cache"
    }
  }
}
